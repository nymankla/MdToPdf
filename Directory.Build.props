<Project>
  <PropertyGroup>
    <!-- Windows 11 (build 22000) TFM; SupportedOSPlatformVersion defaults to the same, so Win11 is the minimum OS. -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Shared so tests run under the same globalization mode as the shipped exe. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Lint: compiler + .NET analyzers + code style, all failing the build. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Required for IDE0005 (unnecessary usings) to run on build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
